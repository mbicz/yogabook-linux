 #!/bin/sh
 set -e
 
+detect_machine() {
+	vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)
+	product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
+	if [ "$vendor" = "Intel Corporation" ] && [ "$product" = "CHERRYVIEW D1 PLATFORM" ]; then
+		echo yb1-x90f
+	elif [ "$vendor" = "LENOVO" ] && [ "$product" = "Lenovo YB1-X91L" ]; then
+		echo yb1-x91l
+	else
+		echo ""
+	fi
+}
+
 if [ "$1" = configure ]; then
+	machine=$(detect_machine)
+	mkdir -p /etc/yogabook-gnss
+	if [ -n "$machine" ] && [ -r "/usr/share/yogabook-gnss/machine.$machine" ]; then
+		cp "/usr/share/yogabook-gnss/machine.$machine" /etc/yogabook-gnss/machine
+	else
+		echo "yogabook-gnss: unsupported DMI vendor/product, no machine profile installed" >&2
+	fi
+
 	local_profile=/etc/apparmor.d/local/usr.sbin.gpsd
 	local_include='#include <local/yogabook-gnss-gpsd>'
 	touch "$local_profile"
@@ -12,7 +32,11 @@ if [ "$1" = configure ]; then
 		apparmor_parser -r /etc/apparmor.d/usr.sbin.gpsd || true
 	fi
 	udevadm control --reload-rules || true
-	udevadm trigger --subsystem-match=tty --sysname-match=ttyS5 || true
+	if [ -r /etc/yogabook-gnss/machine ]; then
+		# shellcheck disable=SC1091
+		. /etc/yogabook-gnss/machine
+		udevadm trigger --subsystem-match=tty --sysname-match="$(basename "${GNSS_UART:-ttyS0}")" || true
+	fi
 	if [ -x /var/lib/yogabook-gnss/root/system/vendor/bin/gpsd ] && \
 		command -v deb-systemd-invoke >/dev/null 2>&1; then
 		deb-systemd-invoke restart yogabook-gnss.service || true
