+/*
+ * Gate charging on the battery gauge's reported capacity. The BQ25890 has no
+ * percentage-based end-of-charge comparator; F_CHG_CFG is the charge-enable
+ * bit, so the driver toggles it as the gauge crosses the configured threshold.
+ * Clearing F_CHG_CFG stops charge FET conduction without forcing the system
+ * onto battery (unlike F_EN_HIZ), so the machine keeps running from VBUS.
+ */
+struct bq25890_capacity_lookup {
+	int capacity;
+	bool found;
+};
+
+static int bq25890_find_battery_capacity(struct power_supply *psy, void *data)
+{
+	struct bq25890_capacity_lookup *lookup = data;
+	union power_supply_propval val;
+	int ret;
+
+	if (psy->desc->type != POWER_SUPPLY_TYPE_BATTERY)
+		return 0;
+
+	ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_CAPACITY, &val);
+	if (ret < 0)
+		return 0;
+
+	lookup->capacity = val.intval;
+	lookup->found = true;
+
+	return 1; /* stop iterating: one battery is enough */
+}
+
+/*
+ * Re-evaluate the charge gate against the current battery capacity. Called
+ * from the gauge's change notification and whenever the limit is written.
+ */
+static void bq25890_apply_charge_limit(struct bq25890_device *bq)
+{
+	struct bq25890_capacity_lookup lookup = { };
+	bool inhibit, was_inhibited;
+	int ret, threshold;
+
+	power_supply_for_each_psy(&lookup, bq25890_find_battery_capacity);
+	if (!lookup.found)
+		return;
+
+	mutex_lock(&bq->lock);
+	threshold = bq->charge_end_threshold;
+	was_inhibited = bq->charge_inhibited;
+	mutex_unlock(&bq->lock);
+
+	/*
+	 * Resume charging with hysteresis, so it does not toggle per percent.
+	 * A limit of 100% means "no limit": the gauge cannot exceed it.
+	 */
+	if (threshold >= 100)
+		inhibit = false;
+	else if (was_inhibited)
+		inhibit = lookup.capacity > threshold;
+	else
+		inhibit = lookup.capacity >= threshold;
+
+	if (inhibit == was_inhibited)
+		return;
+
+	mutex_lock(&bq->lock);
+	ret = bq25890_field_write(bq, F_CHG_CFG, !inhibit);
+	if (ret < 0) {
+		mutex_unlock(&bq->lock);
+		dev_warn(bq->dev, "Failed to %s charging: %d\n",
+			 inhibit ? "suspend" : "resume", ret);
+		return;
+	}
+
+	bq->charge_inhibited = inhibit;
+	mutex_unlock(&bq->lock);
+
+	dev_info(bq->dev, "%s charging at %d%% (limit %d%%)\n",
+		 inhibit ? "Suspended" : "Resumed", lookup.capacity, threshold);
+}
+
+static int bq25890_battery_notifier(struct notifier_block *nb,
+				    unsigned long event, void *data)
+{
+	struct bq25890_device *bq = container_of(nb, struct bq25890_device, battery_nb);
+	struct power_supply *psy = data;
+
+	if (event != PSY_EVENT_PROP_CHANGED || psy == NULL)
+		return NOTIFY_OK;
+	if (psy->desc->type != POWER_SUPPLY_TYPE_BATTERY)
+		return NOTIFY_OK;
+
+	bq25890_apply_charge_limit(bq);
+
+	return NOTIFY_OK;
+}
