--- a/plugins/power/test.py
+++ b/plugins/power/test.py
@@ -1011,6 +1011,104 @@ class PowerPluginTestBatteryLevels(PowerPluginBase):
         self.obj_session_mgr.Uninhibit(dbus.UInt32(inhibit_id),
                 dbus_interface='org.gnome.SessionManager')
 
+class PowerPluginTestAmbient(PowerPluginBase):
+    def start_logind(self):
+        super().start_logind()
+        self.logind_obj.AddObject(
+            '/org/freedesktop/login1/session/auto',
+            'org.freedesktop.login1.Session', dbus.Dictionary({}, signature='sv'),
+            [('SetBrightness', 'ssu', '', '')])
+        self.backlight_session = self.system_bus_con.get_object(
+            'org.freedesktop.login1', '/org/freedesktop/login1/session/auto')
+
+    def start_plugin(self, env):
+        self.settings_gsd_power['idle-dim'] = False
+        self.settings_gsd_power['ambient-enabled'] = True
+        Gio.Settings.sync()
+        self.sensor, self.sensor_obj = self.spawn_server_template(
+            'iio-sensors-proxy',
+            {'has_ambient_light': True, 'light_level': 100.0})
+        self.addCleanup(self.stop_process, self.sensor)
+        super().start_plugin(env)
+
+    def setUp(self):
+        super().setUp()
+        if self.skip_sysfs_backlight:
+            self.skipTest("sysfs backlight support required for test")
+
+        self.screen = dbus.Interface(self.session_bus_con.get_object(
+            'org.gnome.SettingsDaemon.Power', '/org/gnome/SettingsDaemon/Power'),
+            dbus.PROPERTIES_IFACE)
+        deadline = time.monotonic() + 10
+        while not self.sensor_obj.GetInternalProperty('AmbientLightOwners'):
+            self.assertLess(time.monotonic(), deadline, "ambient sensor was not claimed")
+            time.sleep(0.05)
+        # Allow the claim callback to normalize the first reading.
+        time.sleep(1)
+
+    def brightness(self):
+        # Observe every request to the backlight backend, including requests
+        # made between polls, without depending on helper-process latency.
+        calls = self.backlight_session.GetMethodCalls(
+            'SetBrightness', dbus_interface='org.freedesktop.DBus.Mock')
+        if calls:
+            return int(calls[-1][1][2]) - 1
+        return int(self.screen.Get('org.gnome.SettingsDaemon.Power.Screen', 'Brightness'))
+
+    def set_light(self, level):
+        self.sensor_obj.SetInternalProperty(
+            'net.hadess.SensorProxy', 'LightLevel', dbus.Double(level))
+
+    def wait_brightness(self, predicate):
+        deadline = time.monotonic() + 10
+        while True:
+            value = self.brightness()
+            if predicate(value):
+                return value
+            self.assertLess(time.monotonic(), deadline,
+                            "brightness did not reach the ambient target: %d" % value)
+            time.sleep(0.05)
+
+    def test_single_reading_converges_without_jumping(self):
+        initial = self.brightness()
+        previous_raw = 51
+        for level, target in [(20.0, int(initial * 0.2)), (400.0, 100)]:
+            # A long interval without sensor changes must not become a large
+            # first step when the next reading arrives.
+            time.sleep(2)
+            self.backlight_session.ClearCalls(dbus_interface='org.freedesktop.DBus.Mock')
+            self.set_light(level)
+            self.wait_brightness(lambda value: value == target)
+            calls = self.backlight_session.GetMethodCalls(
+                'SetBrightness', dbus_interface='org.freedesktop.DBus.Mock')
+            for _, args in calls:
+                raw = int(args[2])
+                self.assertLessEqual(abs(raw - previous_raw), 5,
+                                     "ambient transition jumped by more than 5%")
+                previous_raw = raw
+
+    def test_manual_change_and_disable_cancel_transition(self):
+        initial = self.brightness()
+        self.set_light(400.0)
+        self.wait_brightness(lambda value: value > initial)
+        self.screen.Set('org.gnome.SettingsDaemon.Power.Screen', 'Brightness', dbus.Int32(35))
+        self.wait_brightness(lambda value: value == 35)
+        time.sleep(1)
+        self.assertEqual(self.brightness(), 35, "ambient transition overrode manual brightness")
+
+        # The next reading establishes the new manual baseline.
+        self.set_light(300.0)
+        time.sleep(0.2)
+        self.set_light(30.0)
+        self.wait_brightness(lambda value: value < 35)
+        self.settings_gsd_power['ambient-enabled'] = False
+        Gio.Settings.sync()
+        time.sleep(0.2)
+        held = self.brightness()
+        time.sleep(1)
+        self.assertEqual(self.brightness(), held, "disabled ambient transition kept running")
+
+
 class PowerPluginTestBrightness(PowerPluginBase):
