+static gboolean
+ambient_transition_cb (gpointer user_data)
+{
+        GsdPowerManager *manager = user_data;
+        gdouble alpha;
+        gint pc;
+        gboolean settled;
+
+        if (!manager->backlight ||
+            !manager->iio_proxy ||
+            !manager->session_is_active ||
+            manager->current_idle_mode != GSD_POWER_IDLE_MODE_NORMAL ||
+            manager->ambient_norm_required ||
+            manager->ambient_manual_pending != 0 ||
+            !g_settings_get_boolean (manager->settings, "ambient-enabled")) {
+                manager->ambient_timeout_id = 0;
+                return G_SOURCE_REMOVE;
+        }
+
+        /* Do not apply a newly received target over an earlier quiet interval,
+         * or catch up in one jump after a delayed main-loop iteration. */
+        alpha = (GSD_AMBIENT_INTERVAL_MS * 1000.0) /
+                (GSD_AMBIENT_TIME_CONSTANT + GSD_AMBIENT_INTERVAL_MS * 1000.0);
+        manager->ambient_accumulator += alpha *
+                (manager->ambient_target - manager->ambient_accumulator);
+
+        /* The backlight API has whole-percent resolution. Finish at the
+         * target instead of approaching the last percentage forever. */
+        settled = fabs (manager->ambient_target - manager->ambient_accumulator) < 1.0;
+        if (settled)
+                manager->ambient_accumulator = manager->ambient_target;
+        pc = manager->ambient_accumulator;
+
+        if (pc != manager->ambient_percentage_old) {
+                g_debug ("Setting brightness from ambient %.1f%%",
+                         manager->ambient_accumulator);
+                gsd_backlight_set_brightness_async (manager->backlight, pc, NULL, NULL, NULL);
+                manager->ambient_percentage_old = pc;
+        }
+
+        if (settled) {
+                manager->ambient_timeout_id = 0;
+                return G_SOURCE_REMOVE;
+        }
+        return G_SOURCE_CONTINUE;
+}
